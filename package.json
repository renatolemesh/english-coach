{
  "name": "saybest",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit && biome check .",
    "fix": "biome check --write .",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "eval": "tsx scripts/eval-conversations.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@huggingface/transformers": "4.3.0",
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/openai": "1.6.0",
    "ajv": "8.20.0",
    "bullmq": "6.3.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "ioredis": "6.0.0",
    "kokoro-js": "1.2.1",
    "nunjucks": "3.2.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "@types/nunjucks": "3.2.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  }
}
