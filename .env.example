# Copie para .env e preencha. Nunca faça commit do .env.
# Nos containers, o docker-compose.yml sobrescreve DATABASE_URL, REDIS_URL, STT_*_CONFIDENCE,
# LOCAL_EMBEDDING_MODEL e CONNECTIONS_FILE; os valores daqui valem para scripts rodados no host.

# dev | test | prod (test: o .env não é lido; os testes definem isso sozinhos)
ENV=dev
LOG_LEVEL=info
# true: cache em memória, LLM/STT/TTS/card falsos, sem banco (só para testes e scripts)
USE_FAKES=false

# --- Infra
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://coach:change-me@localhost:5433/coach
REDIS_URL=redis://localhost:6380/0

# --- OpenRouter (modelos com structured outputs: https://openrouter.ai/models?supported_parameters=structured_outputs)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Só modelos gratuitos por enquanto. Limites do plano grátis (por conta): 20 req/min e
# 50/dia (1000/dia com 10 créditos comprados); ~3 requisições por mensagem.
LLM_MODEL_EVALUATOR=dots-studio/dots-3-note-preview:free
LLM_MODEL_CONVERSATION=dots-studio/dots-3-note-preview:free
LLM_MODEL_GUARD=dots-studio/dots-3-note-preview:free
# reasoning.effort por papel: default (não envia) | none | minimal | low | medium | high.
# Use só com modelos que aceitam reasoning, senão o roteamento falha ("No endpoints found").
LLM_REASONING_EVALUATOR=none
LLM_REASONING_CONVERSATION=none
LLM_REASONING_GUARD=none
# Reservas, tentadas em ordem quando o modelo principal falha (antes do texto fixo).
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_REASONING=low
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_WAIT_S=1
# Tempo máximo de uma chamada somando retries e reservas.
LLM_CHAIN_TIMEOUT_S=60

# --- Embeddings (RAG)
# local: transformers.js na CPU, grátis, modelo embutido na imagem do worker.
# openrouter: pela API (EMBEDDING_MODEL); exige migração se a dimensão mudar.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384
# EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Cache (segundos)
CACHE_TTL_LLM_S=604800
CACHE_TTL_TTS_S=2592000
CACHE_TTL_STT_S=604800
CACHE_TTL_EMBEDDINGS_S=2592000

# --- STT (whisper.cpp). Caminhos dos modelos já vêm definidos na imagem do worker;
# só defina aqui para rodar fora do container (não defina no .env usado pelo compose).
# WHISPER_MODEL_PATH=models/ggml-small.en-q8_0.bin
# WHISPER_VAD_MODEL_PATH=models/ggml-silero-v6.2.0.bin
# WHISPER_CLI=whisper-cli
WHISPER_CPU_THREADS=2
# Confiança média (escala do whisper.cpp): abaixo de MIN pede para repetir; acima de SURE avalia sem ressalva.
STT_MIN_CONFIDENCE=-2.0
STT_SURE_CONFIDENCE=-1.05

# --- TTS (kokoro-js). A voz é escolhida por aluno no /menu (padrão: Sarah).
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DTYPE=fp32
TTS_SPEED=1.0
TTS_CPU_THREADS=2
# Acima de 512 KB o WhatsApp mostra download em vez de play.
VOICE_MAX_BYTES=524288

# --- Limites / guardrails
MAX_AUDIO_SECONDS=90
MAX_AUDIO_BYTES=16777216
MAX_TEXT_CHARS=1000
# Padrão do servidor; o painel pode sobrescrever.
RATE_LIMIT_PER_MINUTE=6
FREE_COMMANDS_PER_MINUTE=30
DAILY_TOKEN_BUDGET=200000
DAILY_COST_BUDGET_USD=0.50
# Marcador anti-vazamento de prompt; vazio = aleatório a cada processo (recomendado).
# PROMPT_CANARY=

# --- RAG (pgvector, busca híbrida; carregue com scripts/ingest.ts)
RAG_ENABLED=true
RAG_K=3
RAG_MAX_CONTEXT_CHARS=1600

# --- Canais e webhooks
# Origem HTTPS pública (nginx): monta as URLs de webhook e do painel.
PUBLIC_BASE_URL=https://seu-dominio
# Cifra as credenciais das conexões. Se mudar, as conexões salvas deixam de abrir.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FERNET_KEY=
# Chave da API de admin (header x-api-key); vazia = API desligada.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=
# Opcional: YAML de conexões aplicado no banco a cada boot da API (veja connections.example.yaml).
# CONNECTIONS_FILE=connections.yaml
META_GRAPH_VERSION=v26.0
WEBHOOK_IDEMPOTENCY_TTL_S=172800
WEBHOOK_MAX_BODY_BYTES=2097152
# Lock por conversa no worker: duração máxima e espera por um turno anterior.
THREAD_LOCK_TIMEOUT_S=300
THREAD_LOCK_WAIT_S=30

# --- Diretórios (padrão: relativos à raiz do projeto; MODELS_DIR=/opt/models no worker)
# PROMPTS_DIR=prompts
# TEMPLATES_DIR=templates
# DATA_DIR=data
# MODELS_DIR=models
